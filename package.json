{
  "name": "thoughtmapper",
  "private": true,
  "version": "0.0.0",
  "overrides": {
    "tar": "^7.5.18",
    "minimatch": "^9.0.7",
    "@xmldom/xmldom": "^0.8.13",
    "postcss": "^8.5.23",
    "js-yaml": "^4.3.1",
    "lodash": "^4.18.0",
    "ip-address": "^10.3.1",
    "esbuild": "^0.25.0",
    "rollup": "^4.34.9",
    "yaml": "^2.8.3",
    "@tootallnate/once": "^3.0.1",
    "form-data": "^4.0.6",
    "@babel/core": "^7.29.6",
    "app-builder-lib": "^26.15.0",
    "builder-util-runtime": "^9.7.0",
    "brace-expansion": "^2.1.2",
    "extract-zip": "^2.0.1"
  },
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-start": "npm run build && electron .",
    "package": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.self.deon",
    "productName": "ThoughtMapper",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "!**/node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "asar": true,
    "asarUnpack": []
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.17",
    "@mui/material": "^5.15.17",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-quadtree": "^3.0.1",
    "html-to-image": "^1.11.13",
    "immer": "^10.1.1",
    "nanoid": "^5.1.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-switch": "^7.0.0",
    "react-toastify": "^10.0.5",
    "reactflow": "^11.4.1",
    "zustand": "^4.2.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  }
}
